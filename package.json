{
  "name": "dsh-cross-session-approval",
  "version": "0.3.9",
  "description": "Cross-session task delegation for DeepSeek Harness 0.2.x, with 10 tools, an approval bridge, child-session permission clamping, and base62 session aliases.",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0"
  }
}
